# Copy to .env and supply your own values. No accounts, applicants or classes are seeded.
POSTGRES_PASSWORD=postgres
APPLICATION_MODE=Assessment
VITE_API_URL=/api
# Optional: ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=...;Username=...;Password=...;
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_URL=http://localhost:3000
INSTITUTION_NAME=
# First real administrator. Remove ADMIN_PASSWORD after initial provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional local preview accounts; forbidden in Production.
DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNTS_PASSWORD=
# Live Stripe credentials only. Sandbox/test payment shortcuts are disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional BulkSMSBD connection. No SMS is marked sent without provider acceptance.
SMS_API_KEY=
SMS_SENDER_ID=
HOLD_DURATION_SECONDS=600
# Per API process; keep all API pools within the PostgreSQL connection budget.
DATABASE_MAX_POOL_SIZE=40
# Required by docker-compose.production.yml
PUBLIC_DOMAIN=
TLS_EMAIL=
